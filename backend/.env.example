# Backend environment (copy to .env)
DATABASE_URL=sqlite:///./shopdoctor.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI layer. Default "mock" runs fully offline (no key needed).
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
LLM_TIMEOUT=30

# Pricing model
DEFAULT_ELASTICITY=-1.4
