# Root environment template (copy to .env for docker compose)
# The app runs fully offline by default — no keys required.

# ---- AI provider ----------------------------------------------------
# mock (default, offline) | openai | anthropic
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- Backend --------------------------------------------------------
DATABASE_URL=sqlite:///./shopdoctor.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DEFAULT_ELASTICITY=-1.4
